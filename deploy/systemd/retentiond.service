# TeslaUSB B-1 — retentiond runs independently of indexd/scannerd daemons:
# it reads teslacam.img directly via linked scannerd library APIs and self-retries
# on startup races where the archive/image appears after boot. I/O is explicitly
# idle/low weight so clip archiving yields to foreground workloads and car-write
# pressure.
#
# !! ExecStart below ARMS PERMANENT DELETION of archived footage. Deliberate. !!
# The archive directory is the only unbounded-growth consumer on the card
# (teslacam.img is fixed-size and Tesla ring-buffers it internally), so without a
# space governor the card fills, writes fail, and the appliance stops recording.
# An appliance that stops recording to preserve old clips has failed at its job.
# So the governor ships armed, exactly as Tesla ring-buffers its own RecentClips.
#
# Deletion is NOT gated on the clip existing anywhere else: retentiond wires
# allow_undurable to --enable-eviction, bypassing indexd's PROVEN_DURABLE gate.
# Accepted tradeoff — backing up before eviction is the owner's responsibility.
# SavedClips and SentryClips are structurally never evictable; see
# docs/specs/retention-eviction.md for the full policy and the opt-out.
#
# --recency-floor-secs is passed EXPLICITLY even though 3600 is currently the
# built-in default (config.rs TargetDrainConfig::default). It is the safety floor
# that keeps just-recorded footage out of the eviction candidate set, so it must
# not depend on an implicit library default: a future change to that default would
# silently alter deletion eligibility on every device with no diff to review here.
[Unit]
Description=TeslaUSB retentiond (archiving + retention + space governor)
Documentation=https://github.com/mphacker/TeslaUSB
RequiresMountsFor=/data/teslausb
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/retentiond serve --archive-recent-only --enable-eviction --recency-floor-secs 3600 --allow-permanent-loss --archive-root /data/teslausb/archive --volume-image /data/teslausb/teslacam.img
Restart=always
RestartSec=5s
# Catch hangs that do not exit; Restart=always only recovers after failure/exit.
# This is a systemd *service* watchdog (sd_notify WATCHDOG=1), not the hardware
# /dev/watchdog timer. 240s clears the worst-case single-clip copy+hash+fsync
# stall under microSD contention with margin; a false kill is bounded (no footage
# loss — copies are non-destructive staged-promote, markers durable per ADR-0006).
WatchdogSec=240
NotifyAccess=main
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
OOMScoreAdjust=100
# panic=abort means any panic is a hard exit; suppress coredumps so a
# transient crash-restart cycle can never spam the microSD with dumps.
LimitCORE=0
SyslogIdentifier=retentiond

[Install]
WantedBy=multi-user.target
