# TeslaUSB B-1 — uploadd: durable, resumable cloud upload queue. Uploads archived
# footage to the configured remote behind the index seam, honoring upload leases
# and the wifid TX-cap throttle. It NEVER reads the car-facing LUN, deletes, or
# reboots (uploadd.md). It is the most-disposable service.
#
# STAGED — installed but NOT enabled by default. `uploadd serve`'s live loop
# (queue hydration, wifid subscription, lease handling) is gated on the WiFi
# TX-cap spike (Task 2.6) + the upload backend decision (rclone vs native); until
# that lands the binary's `serve` exits non-zero by design. So the installer
# copies this unit FILE but does NOT enable/start it (TESLAUSB_STAGED_SERVICES in
# setup-lib/common.sh). When the live loop lands: move the name into
# TESLAUSB_APP_SERVICES.
#
# NOTE on LoadCredential=: the contract (cloud-provider-creds.md §5) wants the
# credential blob passed via systemd's $CREDENTIALS_DIRECTORY. Deliberately NOT
# wired yet, for two reasons: uploadd currently opens the blob straight from
# --cloud-state-dir and never reads $CREDENTIALS_DIRECTORY (so the directive would
# be dead weight), and LoadCredential= with a missing source is a start-time
# hazard on a fresh device that has no credential yet — where uploadd must start
# normally and simply skip cloud upload. Wire both halves together, or not at all.
#
# Hardening note: **`MemoryMax=`/`MemoryHigh=` DO NOT WORK on this target.** The
# Raspberry Pi OS kernel cmdline ships `cgroup_disable=memory`, so /proc/cgroups
# has no memory subsystem and systemd accepts memory limits then silently ignores
# them (verified on-device, spike vs-0b 2026-07-27: system.slice controllers are
# `cpu io pids`; an existing unit reads back MemoryMax=infinity). Do NOT add a
# memory limit here expecting enforcement — enabling it means editing
# /boot/firmware/cmdline.txt + reboot, which is boot-critical and, per the spike,
# unnecessary: rclone's peak RSS is a flat 57-64 MB (it streams; RSS does not grow
# with clip size) against ~200 MB free. The OOM order (SPEC.md §7) is therefore
# enforced solely by OOMScoreAdjust below — which needs no cgroup — making uploadd
# the FIRST process killed under pressure, protecting recording.
#
# Install: copy to /etc/systemd/system/uploadd.service, then daemon-reload
#   (enable only once the upload live wiring — Task 2.6 — lands).
[Unit]
Description=TeslaUSB uploadd (durable cloud upload queue)
Documentation=https://github.com/mphacker/TeslaUSB
# Needs the catalog (queue source) and archive; uploads need the network online.
RequiresMountsFor=/data/teslausb /var/lib/teslausb
After=local-fs.target indexd.service wifid.service network-online.target
Wants=indexd.service wifid.service network-online.target

[Service]
Type=simple
# Runtime secrets (the rendered rclone.conf) live on tmpfs under /run/teslausb.
# PRESERVE: /run/teslausb is SHARED with gadgetd-control, scannerd, schedulerd,
# indexd and wifid (they all bind sockets / drop status files here). systemd does
# NOT reference-count RuntimeDirectory across units, so without Preserve=yes a
# `systemctl stop uploadd` — or an on-failure restart — tears down /run/teslausb
# and unlinks those peers' LIVE sockets, silently killing the webd->gadgetd write
# path. Mode 0750 matches the peers so the dir's mode does not flip on us.
RuntimeDirectory=teslausb
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/bin/uploadd serve
# `panic=abort` and SIGKILL bypass Rust `Drop`; enforce runtime-secret cleanup
# in systemd on every stop path.
ExecStopPost=/usr/bin/rm -f /run/teslausb/rclone.conf
Restart=on-failure
RestartSec=5s
OOMScoreAdjust=900
SyslogIdentifier=uploadd

[Install]
WantedBy=multi-user.target
